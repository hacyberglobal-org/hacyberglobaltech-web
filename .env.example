# Environment Variables - HACYBERGLOBALTECH Production Deployment
# Copy this file to .env.local and populate with actual values
# Never commit secrets, credentials, or private keys to version control

# ============================================================================
# AUTHENTICATION & AUTHORIZATION (Better Auth + OAuth)
# ============================================================================

# Enable/disable sign-in UI (default: false for shipped template)
# Set to "true" in production deployment for real OAuth via Grok broker
# VITE_AUTH_ENABLED=false

# OAuth Broker Configuration (injected by Vercel for production)
# Contact: deployment team to receive production-issued credentials
# GROK_AUTH_ISSUER=https://your-broker-issuer.example.com
# GROK_AUTH_CLIENT_ID=your-client-id
# GROK_AUTH_CLIENT_SECRET=your-client-secret

# Better Auth Configuration (deployed apps only)
# BETTER_AUTH_URL=https://hacyberglobaltech-web.vercel.app
# BETTER_AUTH_SECRET=<random-32-byte-hex-string-generated-by-deployer>

# ============================================================================
# DATABASE (PostgreSQL in production)
# ============================================================================

# Production: injected by Vercel
# Local: use embedded PGLite (no env var needed)
# DATABASE_URL=postgresql://user:password@host:5432/database

# ============================================================================
# RECAPTCHA ENTERPRISE (Client-side public key only - safe to expose)
# ============================================================================

# reCAPTCHA Enterprise site key (public, embedded in client bundle)
# VITE_RECAPTCHA_SITE_KEY=6LftgN0tAAAAAEOGlM-Q6M9UUonT12BvtdjIAyJY

# ============================================================================
# GOOGLE ANALYTICS / MONITORING
# ============================================================================

# Vercel Analytics
# VITE_VERCEL_ANALYTICS_ID=your-analytics-id

# ============================================================================
# NOTES
# ============================================================================

# - Prefix variables with VITE_ to expose them to the client bundle
# - Keep this file in version control as documentation (NO SECRETS)
# - Use .env.local (gitignored) for actual credentials during development
# - Production secrets are injected by the deployment platform (Vercel)
# - Never commit .env.local, credentials, service accounts, or tokens
